# Database
NOTI_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/noti
NOTI_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/noti_test

# Driver: console | smtp | graph
NOTI_MAIL_DRIVER=console
NOTI_MAIL_FROM=noreply@hust.edu.vn

# SMTP configuration (khi dùng driver smtp)
NOTI_SMTP_HOST=smtp.example.com
NOTI_SMTP_PORT=587
NOTI_SMTP_USER=user@example.com
NOTI_SMTP_PASSWORD=dummy_password

# Microsoft Graph configuration (khi dùng driver graph)
NOTI_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
NOTI_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
NOTI_GRAPH_CLIENT_SECRET=dummy_client_secret
NOTI_GRAPH_CERTIFICATE_PATH=

# Staging policy: allowlist phân tách bằng dấu phẩy; redirect_to nếu gửi ngoài allowlist
NOTI_RECIPIENT_ALLOWLIST=hust.edu.vn
NOTI_REDIRECT_TO=dev-test@hust.edu.vn

# Performance & Security
NOTI_MAX_BODY_BYTES=65536
NOTI_SEND_RATE_PER_MINUTE=30
