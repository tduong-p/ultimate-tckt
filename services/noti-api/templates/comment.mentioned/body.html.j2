{% extends "_layout/layout.html.j2" %}
{% block content %}
<p>Xin chào <strong>{{ recipient_name or "bạn" }}</strong>,</p>
<p><strong>{{ actor }}</strong> đã nhắc đến bạn trong một bình luận:</p>
<div style="background: #f6f8fa; border-left: 4px solid #0969da; padding: 12px; margin: 16px 0;">
  {% if task is defined and task.get('title') %}
  <p style="margin: 0 0 8px 0;"><strong>Công việc:</strong> (TCKT-{{ task.id }}) {{ task.title }}</p>
  {% endif %}
  <p style="margin: 0 0 8px 0;"><strong>Hoạt động:</strong> {{ activity.title }}</p>
  <p style="margin: 0 0 8px 0;"><strong>Nội dung:</strong></p>
  <blockquote style="margin: 0; padding: 8px 12px; background: #ffffff; border: 1px solid #d0d7de; border-radius: 4px;">{{ comment.body }}</blockquote>
</div>
<p>
  <a class="button" href="{{ base_url }}{{ activity.path }}">Xem bình luận</a>
</p>
{% endblock %}
