DATABASE_URL=mysql+pymysql://root:root@localhost:3306/ctd?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://root:root@localhost:3306/ctd_test?charset=utf8mb4

# Môi trường chạy: dev | staging | production.
# Chỉ APP_ENV=dev mới được dùng JWT_SECRET mặc định bên dưới; mọi giá trị khác
# mà quên đặt JWT_SECRET riêng thì app TỪ CHỐI khởi động (xem app/config.py).
APP_ENV=dev

# BẮT BUỘC đổi trước khi deploy: chuỗi này công khai trong repo, ai đọc được
# cũng ký được token quản trị. Sinh chuỗi mới: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=doi-chuoi-nay-o-moi-truong-that
# Thời hạn token đăng nhập (phút).
JWT_TTL_MINUTES=480

# Mặc định "console": chỉ in email ra log, KHÔNG gửi mail thật.
# Bật gửi mail thật: đặt MAILER_DRIVER=smtp rồi điền nhóm SMTP bên dưới.
MAILER_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@vidu.edu.vn

# Mặc định "memory": file KHÔNG được lưu thật, mất khi service khởi động lại.
# Bật lưu trữ thật: đặt STORAGE_DRIVER=s3 rồi điền nhóm S3 bên dưới.
STORAGE_DRIVER=memory
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
