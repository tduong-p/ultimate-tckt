# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env.

# --- Cơ bản ---
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Để trống = dùng SQLite (dev). Production (Render/Supabase) dùng Postgres:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Thông báo ---
NOTIFIER_DRIVER=console            # console (MVP) | graph (khi có quyền)
TCKT_CC=tckt@truong.edu.vn          # Cc cố định mọi email (cách nhau dấu phẩy)
REMINDER_DAYS=5
REMINDER_REPEAT_DAYS=3
CRON_TOKEN=                         # chuỗi ngẫu nhiên, bảo vệ /cron/run/

# --- Đăng nhập Microsoft (Entra ID) — điền khi tạo App Registration ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=organizations          # hoặc tenant id của trường

# --- Gửi email Graph (Phase 1.5) ---
MS_SENDER=                          # shared mailbox, vd: vanphongdoan@truong.edu.vn
