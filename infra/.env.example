# /opt/ultimate-tckt/<env>/infra/.env trên VM. KHÔNG commit file thật.
# bootstrap-vm.sh sinh file này từ .env.<env> của host cũ (đổi tiền tố biến app sang CORE_*).
CORE_MYSQL_ROOT_PASSWORD=
CORE_DB_NAME=
CORE_DB_USER=
CORE_DB_PASSWORD=
CORE_SESSION_SECRET=
# openssl rand -base64 32 — bootstrap tự sinh nếu thiếu
CORE_SETTINGS_ENCRYPTION_KEY=
CORE_DEVOPS_EMAILS=
# Chỉ staging: key Core gọi Noti, tạo bằng `python -m noti.cli create-client core` (docs/ops/moi-truong.md §4a). Trống = không gửi
CORE_NOTI_API_KEY=
CTD_DB_NAME=
CTD_DB_USER=
CTD_DB_PASSWORD=
CTD_JWT_SECRET=
# Noti (chỉ staging): database `noti` trên ctd-db. Mật khẩu: openssl rand -hex 24
NOTI_DB_NAME=
NOTI_DB_USER=
NOTI_DB_PASSWORD=
# console (mặc định, chỉ ghi log) | smtp | graph. Để trống các biến dưới nếu dùng console.
NOTI_MAIL_DRIVER=
NOTI_MAIL_FROM=
# Chỉ gửi tới domain/địa chỉ này (phân tách dấu phẩy); ngoài danh sách thì chuyển về NOTI_REDIRECT_TO hoặc bỏ. Production: bắt buộc khác rỗng (compose từ chối chạy nếu rỗng)
NOTI_RECIPIENT_ALLOWLIST=
NOTI_REDIRECT_TO=
# CC cố định cho mọi thư Noti gửi đi (phân tách dấu phẩy, bỏ qua allowlist; chỉ dùng hộp thư tổ chức kiểm soát). Rỗng = tắt
NOTI_ALWAYS_CC=
NOTI_SMTP_HOST=
NOTI_SMTP_PORT=
NOTI_SMTP_USER=
NOTI_SMTP_PASSWORD=
NOTI_GRAPH_TENANT=
NOTI_GRAPH_CLIENT_ID=
NOTI_GRAPH_CLIENT_SECRET=
